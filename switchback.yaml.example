# switchback example config
#
# switchback user config. Place copies at EITHER or BOTH of these locations:
#   <project>/.pi/switchback.yaml    per-project layer (gitignored, never committed)
#   ~/.pi/agent/switchback.yaml      your global layer
#
# The two layers are AGGREGATED: the merged model list is the global list with
# per-project entries overriding same-id entries in place (a duplicated model id
# means the project entry wins wholesale) and project-only models appended.
#
# The project-local slot is `.pi/` on purpose: git ignores it, so the real
# config can never end up in a repository. This repository ships only this
# example file.
#
# User config is YAML only - a .json config is rejected.
#
# Diagnostics: one notification per model switch (classifier verdict, reset
# window, and how the reasoning category resolved against the activated model).
# The SWITCHBACK_DEBUG=1 environment variable overrides this.
#
# debug: true
#
# Pinning: `/switchback-next` (the per-virtual-model "cycle the fallback list"
# command) writes its result to <piConfigDir>/switchback/pin.json. Setting
# `debug: true` makes the resolution visible on every manual change too. A pin
# is honored on `user`/`direct` routes as long as the pinned model is usable;
# otherwise the session falls through to its current stickiness / preference.
#
# Idle reset: `idleReset:` returns a long-idle session to the first entry of the
# list (the provider cache is cold anyway, and a short-window/no-weekly-cap model
# is worth spending first). Values: never (default), 30m, 1h, 2h, 3h, 5h, 12h,
# 24h, or `classifier` to let the decision model judge. A pin outranks it.
#
# Thinking levels: the offered scale is fixed at off / minimal / medium / high
# / max. When a configured fallback cannot express the requested category
# (e.g. zai has no "medium" and cannot disable thinking), switchback asks the
# configured SystemOne classifier to pick the nearest supported level, or
# clamps when the classifier is unavailable.
#
# Decision models: a chain names its classifier by address, exactly like a
# fallback - `decisionModel: provider/model-id`. Connection details live in the
# optional `decisionModels:` map (keyed by the same address) or the
# `decisionProviders:` map (keyed by provider id alone, one entry serving every
# model of that provider; an address-level entry overrides it). An address with
# no connection resolves from pi's classifier catalog; a `baseUrl` is a direct
# System One endpoint (Ollama v0.35+) that switchback drives itself. OpenCode
# has no catalog - there every referenced address needs a provider entry or an
# override. Unknown or retired keys are reported as warnings, never silently
# ignored.
#
# The `fallbacks` list below is the ordered preference. Each id was verified to
# resolve in the catalog at the time of writing (2026-10-04) using a credentialed
# session. Re-run `pi --list-models <provider>` to confirm before relying on any
# of them. If a configured id stops resolving, switchback greys it out at route
# time and reports it via `/switchback` - the config is left untouched so a
# transient catalog churn does not silently delete a fallback the user wants.
#
# All four providers and the preferred model ids below match the corpus the
# classification prompts were validated against. They are not invented.
#
#   z.ai GLM         - 5h window (12+ real samples in the classification corpus).
#   Ollama Cloud Pro - weekly + session windows (8 real samples).
#   MiniMax Plus     - 5h window via "Token Plan usage limit reached" (4 real samples).
#   OpenCode-Go      - transient-only corpus (no quota samples). Region constraint
#                      is account-specific; if you hit it, see /switchback status.

models:
  - id: auto                          # bare id: normalised to "switchback/auto"
    name: Auto (Switchback)
    fallbacks:
      - zai/glm-5.3              # 1M context, current z.ai GLM coding plan
      - ollama-cloud/glm-5.3-flash # 1M context, vision-capable fallback
      - minimax/MiniMax-M3       # 1M context, minimax Plus default
      - opencode-go/glm-5.3-flash # 1M context, opencode-go fallback
    # Return to the first entry above after a long idle gap (default: never).
    idleReset: 5h
    # Decision model. Two resolutions, chosen by the address you name:
    #
    # 1. `provider/model-id` with no entry in `decisionModels:` below - pi
    #    resolves it from its classifier catalog and supplies the endpoint, the
    #    wire API and the credential (whatever /login configured).
    decisionModel: typesafe/jev-latest
    #
    # 2. The same address WITH an entry carrying a `baseUrl` - a direct System
    #    One endpoint switchback registers itself. Works with Ollama v0.35+
    #    decision models: `ollama show <model>` must list the "decision"
    #    capability (e.g. tev1:0.8b). A plain chat GGUF is rejected by Ollama.
    #    Pick an id pi does not already serve, or pi will replace that provider's
    #    chat models with the classifier alone.
    #
    # decisionModel: ollama/tev1:0.8b
  - id: auto-flash                    # bare id: normalised to "switchback/auto-flash"
    name: Auto (Switchback) - Flash
    fallbacks:
      - zai/glm-5.3-flash
      - minimax/MiniMax-M3
      - ollama-cloud/glm-5.3-flash
      - opencode-go/mimo-v2.6-flash

# Connection details for direct endpoints. Two maps, one rule: `decisionModels:`
# is keyed by the full address (a one-off override), `decisionProviders:` by the
# provider id (covers every model of that provider). An override replaces the
# provider entry as a whole: an empty override is not "inherit the rest" - it
# puts that address back on catalog resolution.
#
# decisionProviders:
#   ollama:
#     baseUrl: http://localhost:11434/v1
#     apiKey: local            # local servers ignore the token, but the
#                              # transport refuses to send without one; use
#                              # secret:<name> for a real key.
#
# decisionModels:
#   "ollama/tev1:0.8b":
#     baseUrl: http://localhost:11434/v1   # a one-off override for one address
#     apiKey: local                        # required with baseUrl
#   "ollama/tev2:0.8b": {}                 # empty override: this one address
#                                          #   ignores the provider entry and
#                                          #   stays catalog-resolved
#   "gpu-ollama/tev9":
#     baseUrl: http://gpu:11434/v1         # a one-off direct endpoint
#     apiKey: secret:gpu-key               # stored encrypted under
#                                          #   switchback/secrets.json (managed
#                                          #   via /switchback-config or the
#                                          #    secrets store directly).
